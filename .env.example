# Copy to .env (git-ignored) and adjust. Used by docker-compose.yml only —
# the dashboard's VITE_API_URL lives in dashboard/.env.example.

POSTGRES_USER=farm
POSTGRES_PASSWORD=farm-dev-password
POSTGRES_DB=farmdb

# Host ports — defaults avoid the crowded 8080/8081/5432 so the stack can run
# beside other local services without clashes.
POSTGRES_PORT=5433
APP_PORT=8082
ADMINER_PORT=8083

# Set to false to boot with an empty database (no demo data)
SEED_DEMO_DATA=true

# Signs the API's JWT access tokens. Set a long random string (e.g. from
# `openssl rand -hex 32`); unset = random per boot, so access tokens die on
# restart (clients recover via their refresh token).
JWT_SECRET=

# Enables "Sign in with Google" (optional). Create an OAuth client at
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (type: Web application), then:
#   - dashboard: add your origins (http://localhost:8082, dev :5173) as
#     Authorized JavaScript origins
#   - mobile (Expo Go): add https://auth.expo.io/@<user>/<app> as an
#     Authorized redirect URI
# Empty = Google login hidden, email+password still works.
GOOGLE_CLIENT_ID=

# Irrigation engine tick cadence (auto mode, Duration stop, schedules, rules
# r1/r2 run server-side — backend/internal/engine). Go duration string; empty =
# the default 30s.
ENGINE_INTERVAL=30s

# Telemetry history kept in TimescaleDB, in days. Older readings are dropped
# by a retention policy; empty or 0 keeps everything (readings older than 7
# days are compressed either way, so years of history stay small).
TELEMETRY_RETENTION_DAYS=0

# Alert notifications (server-side alerts, backend/internal/alerts): a
# Telegram bot token + one chat id (e.g. the family group) gets one message
# per alert activation, when the farm's Telegram preference is on. Create a
# bot with @BotFather, get the chat id by messaging it and visiting
# https://api.telegram.org/bot<TOKEN>/getUpdates. Either empty = disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMS alerts and the Friday weekly summary (backend/internal/notify): a generic
# HTTP gateway. The server POSTs {"to": "<phone>", "text": "<message>"} as JSON
# (with "Authorization: Bearer <token>" when a token is set); any 2xx is
# success. Point it at your SMS provider, or a small adapter in front of one.
# Recipients are the phone numbers people save under Settings → My contact,
# used when the farm's SMS notification is on. Empty URL = SMS disabled.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# Deployment flavour. ENV=production makes JWT_SECRET mandatory (the server
# refuses to boot without it) and turns REQUIRE_DEVICE_KEY on.
ENV=

# Refuse telemetry from devices without a key. Defaults to on when
# ENV=production; set true/false to override. Production also requires
# SEED_DEMO_DATA=false (the demo seed ships public passwords and device keys).
REQUIRE_DEVICE_KEY=

# Browser origins allowed to call the API cross-origin, comma-separated
# ("*" = any). Leave empty for same-origin only (the default; the bundled
# dashboard needs nothing here).
CORS_ORIGINS=

# --- running the Go server outside docker compose -----------------------------
# (docker-compose.yml sets these for you.) DATABASE_URL, if set, wins over the
# DB_* parts; PORT defaults to 8000.
# DATABASE_URL=postgres://farm:farm-dev-password@localhost:5433/farmdb?sslmode=disable
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=farm
# DB_PASSWORD=farm-dev-password
# DB_NAME=farmdb
# DB_SSLMODE=disable
# PORT=8000
# Serve a built dashboard (dashboard/dist) from the same port:
# STATIC_DIR=../dashboard/dist

# --- tests ------------------------------------------------------------------
# Database-backed Go tests run when this is set and skip otherwise. Any empty
# PostgreSQL works (each package gets its own schema, so they can run in
# parallel); the tests wipe those schemas, never point it at real data.
#   docker run -d --name farm-test-pg -e POSTGRES_PASSWORD=t -e POSTGRES_DB=farmtest -p 55432:5432 postgres:17
#   TEST_DATABASE_URL="postgres://postgres:t@localhost:55432/farmtest?sslmode=disable" go test ./...
# TEST_DATABASE_URL=
